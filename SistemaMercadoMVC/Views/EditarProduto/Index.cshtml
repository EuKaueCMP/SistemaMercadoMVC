@model SistemaMercadoMVC.Models.Produto

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Sistema mercado | Editar Produtos</title>
    <script src="./js/site.js"></script>
    <link rel="stylesheet" href="./css/site.css" />
</head>
<body>
    <h1>Editar Produtos</h1>
    <form action="/Produto/@Model.ProdutoId/Salvar" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label for="nome">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" value="@Model.NomeProduto" placeholder="Digite o nome do produto" />
        </div>
        <div class="form-group">
            <label for="descricao">Descricao</label>
            <input type="text" class="form-control" id="descricao" name="descricao" value="@Model.Descricao" placeholder="Digite a descricao do produto" />
        </div>
        <div class="form-group">
            <label for="imagem">Imagem</label>
            <input type="file" class="form-control" id="imagem" name="imagem" placeholder="Digite o caminho da imagem do produto" />
        </div>
        <div class="form-group">
            <label for="preco">Preço</label>
            <input type="number" class="form-control" id="preco" name="preco" value="@Model.Preco" placeholder="Digite o preço do produto" />
        </div>
        <button type="submit" class="btn btn-primary">Editar</button>

        @*Exibir somente se houver algum erro*@
        <p class="erro-login @(ViewBag.Erro != null ? "mostra" : "")">
            @* Para usar c# no html *@
            @ViewBag.Erro
        </p>
    </form>
</body>
</html>
